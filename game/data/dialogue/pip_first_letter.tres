[gd_resource type="Resource" script_class="Dialogue" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = &"pip_first_letter"
speaker = &"pip"
priority = 70
once = true
bark = false
when = {
"chapters": [0],
"flags_none": ["met_pip"]
}
nodes = Array[Dictionary]([{
"id": "start",
"text": "Special delivery! You're {name}, right? Course you are, there's nopony else up here. I'm Pip. Mail, gossip, emergency muffins.",
"who": "pip",
"mood": "happy",
"flag": "met_pip",
"next": "two"
}, {
"id": "two",
"text": "This one's from Cloudsdale. They write ever so much. Your welcome pack is in your mailbox by the door. There's a postcard in it, too!",
"who": "pip",
"mood": "happy",
"event": "first_mail",
"next": "three"
}, {
"id": "three",
"text": "See the rainbow over the hills? Cloudsdale makes those. Prettiest thing in the valley, if you ask me.",
"who": "pip",
"mood": "happy",
"anim": "look"
}])
