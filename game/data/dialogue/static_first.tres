[gd_resource type="Resource" script_class="Dialogue" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = &"static_first"
speaker = &"static"
priority = 110
once = true
bark = false
when = {
"path": "rescue",
"flags_none": ["static_met"]
}
nodes = Array[Dictionary]([{
"id": "start",
"text": "You ran. Good. I've stood at this fence a long time, waiting for a steward to run.",
"who": "static",
"mood": "blank",
"next": "two"
}, {
"id": "two",
"text": "I went up on a Color Day too. I came back down without mine.",
"who": "static",
"mood": "sad",
"anim": "look",
"next": "three"
}, {
"id": "three",
"text": "Four pylons feed that rainbow, one in every region. Cut them at night and the Works goes hungry.",
"who": "static",
"mood": "blank",
"anim": "nod",
"next": "four"
}, {
"id": "four",
"text": "Cut all four, and I'll get you back inside. Find friends on the way. You'll need them.",
"who": "static",
"mood": "happy",
"flag": "static_met"
}])
