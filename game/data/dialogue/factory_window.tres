[gd_resource type="Resource" script_class="Dialogue" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = &"factory_window"
speaker = &"marigold"
priority = 0
once = false
bark = false
when = {
"flags_all": ["in_factory"]
}
nodes = Array[Dictionary]([{
"id": "start",
"text": "Oh. You found the window.",
"who": "marigold",
"mood": "blank",
"next": "two"
}, {
"id": "two",
"text": "Don't make that face. Weather needs color, and a Drifter's color was only ever on loan.",
"who": "marigold",
"mood": "happy",
"next": "three"
}, {
"id": "three",
"text": "It doesn't hurt. Nopony has ever said it hurts.",
"who": "marigold",
"mood": "happy",
"anim": "look",
"next": "four"
}, {
"id": "four",
"text": "So, my little offer. Sign the Senior Steward contract: double stipend, better tools, and Tumble struck off the lottery. She goes home with you tonight.",
"who": "marigold",
"mood": "happy",
"anim": "nod",
"choices": [{
"text": "Sign. Tumble comes home, and the line keeps running.",
"next": "sign"
}, {
"text": "Refuse. I'll get Tumble out of that line myself.",
"next": "run"
}]
}, {
"id": "sign",
"text": "Wonderful. I knew you were one of us. She'll be waiting at the lift.",
"who": "marigold",
"mood": "happy",
"event": "path_factory"
}, {
"id": "run",
"text": "Oh, {name}.",
"who": "marigold",
"mood": "blank",
"next": "run2"
}, {
"id": "run2",
"text": "Then you'd better be quick. I'll count to ten. That's a kindness.",
"who": "marigold",
"mood": "blank",
"anim": "look",
"event": "path_rescue"
}])
