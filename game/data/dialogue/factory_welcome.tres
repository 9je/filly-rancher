[gd_resource type="Resource" script_class="Dialogue" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = &"factory_welcome"
speaker = &"marigold"
priority = 0
once = false
bark = false
when = {
"flags_all": ["in_factory"]
}
nodes = Array[Dictionary]([{
"id": "start",
"text": "Welcome to the Rainbow Factory! Mind the step, the clouds are a little springy.",
"who": "marigold",
"mood": "happy",
"next": "two"
}, {
"id": "two",
"text": "Every rainbow over Equestria starts right here. And every pony who comes up the lift helps make it. Follow me!",
"who": "marigold",
"mood": "happy",
"anim": "nod"
}])
