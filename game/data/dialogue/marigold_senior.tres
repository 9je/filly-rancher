[gd_resource type="Resource" script_class="Dialogue" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = &"marigold_senior"
speaker = &"marigold"
priority = 90
once = true
bark = false
when = {
"path": "factory",
"flags_none": ["marigold_senior_done"]
}
nodes = Array[Dictionary]([{
"id": "start",
"text": "Senior Steward! The Supply Desk at the market has your new equipment. Calm Lamps, a Yield Lens, the works. Contracts go up on the board.",
"who": "marigold",
"mood": "happy",
"next": "two"
}, {
"id": "two",
"text": "Fill them and you'll climb. Regional Director, one day! I just know it.",
"who": "marigold",
"mood": "happy",
"anim": "nod",
"flag": "marigold_senior_done"
}])
