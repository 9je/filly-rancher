[gd_resource type="Resource" script_class="StoryBeat" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
id = &"sunny_quota_note"
chapter = &"SUNNY"
trigger = &"COLLECTION_DAYS"
threshold = 1
sender = "Cloudsdale Weather Corporation"
title = "Your first collection day"
body = PackedStringArray("Dear {name},", "", "YOU OWE: {owed} bits", "QUOTA: {quota} ponies with their mark", "DUE BY: Day {due_day}, in {days} days", "", "Bring ponies with their mark to the Depot before then.", "Pay bits off on its Pay tab. Meet the quota and nothing", "happens. Miss it and an associate calls.", "", "Collection day has been and gone, and this period's upkeep", "is on your account. No pressure at all! Partners who meet", "quota sleep so much better.", "", "Yours in weather, Sponsorship Services")
reveals = PackedStringArray()
evidence = false
reply = &"NONE"
