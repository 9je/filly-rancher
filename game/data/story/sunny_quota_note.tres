[gd_resource type="Resource" script_class="StoryBeat" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
id = &"sunny_quota_note"
chapter = &"SUNNY"
trigger = &"COLLECTION_DAYS"
threshold = 1
sender = "Cloudsdale Weather Corporation"
title = "Your first collection day"
body = PackedStringArray("Dear {name},", "", "Collection day has been and gone, and this period's", "upkeep is on your account.", "", "We expect {quota} ponies with their color a period.", "Bits pay the balance, and the account is closed on a", "collection day, paid in full with the quota met.", "It is all set out on the Pay tab at the Depot.", "", "No pressure at all. Partners who meet quota sleep so", "much better.", "", "Yours in weather, Sponsorship Services")
reveals = PackedStringArray()
evidence = false
reply = &"NONE"
