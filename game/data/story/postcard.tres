[gd_resource type="Resource" script_class="StoryBeat" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
id = &"postcard"
chapter = &"SUNNY"
trigger = &"CHAPTER"
threshold = 0
sender = "The Academy, Cloudsdale"
title = "A postcard from the clouds"
body = PackedStringArray("Dear {name},", "", "Having a wonderful time at the Academy!", "I found my talent! Everypony here is so nice.", "", "Love, {pony}", "", "Card printed and posted by Intake")
reveals = PackedStringArray()
evidence = true
reply = &"NONE"
template = true
