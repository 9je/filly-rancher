[gd_resource type="Resource" script_class="StoryBeat" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
id = &"weather_requisition"
chapter = &"WEATHER"
trigger = &"SURVEY_DAYS"
threshold = 2
sender = "Cloudsdale Weather Corporation"
title = "Priority Requisition"
body = PackedStringArray("Dear {name},", "", "Thank you for your survey response!", "", "Following it, {chosen} has been selected for", "priority handling. A collector will call at dawn", "and walk her over himself.", "", "The bonus schedule is attached and is generous.", "No action is required from you at all.", "", "Yours in weather, Logistics")
reveals = PackedStringArray()
evidence = true
reply = &"NONE"
