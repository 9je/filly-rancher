[gd_resource type="Resource" script_class="StoryBeat" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
id = &"weather_yield"
chapter = &"WEATHER"
trigger = &"DELIVERIES"
threshold = 5
sender = "Cloudsdale Weather Corporation"
title = "Your quarterly performance summary"
body = PackedStringArray("Dear {name},", "", "Shipments received from your ranch: {count}.", "Every one of them arrived happy and well cared for.", "Spectra grade: A.", "", "The sponsorship team is delighted. Keep them coming,", "and do enjoy the weather this quarter.", "", "Warmly, Sponsorship Services")
reveals = PackedStringArray()
evidence = true
reply = &"NONE"
